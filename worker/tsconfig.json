{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "src/**/*.ts",
    "../scripts/lib/collector.ts",
    "../scripts/lib/github.ts",
    "../src/domain/**/*.ts"
  ]
}
