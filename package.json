{
  "name": "opensource-deck",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "A personal command center for open-source contributions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranxi2001/opensource-deck.git"
  },
  "homepage": "https://onefly.top/opensource-deck/",
  "bugs": {
    "url": "https://github.com/ranxi2001/opensource-deck/issues"
  },
  "keywords": [
    "github",
    "open-source",
    "contributions",
    "issues",
    "cli",
    "agent-skill"
  ],
  "files": [
    "dist-cli/",
    "skills/opensource-deck/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "opensource-deck": "dist-cli/osdeck.cjs",
    "osdeck": "dist-cli/osdeck.cjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web && npm run build:cli",
    "build:web": "tsc -b && vite build",
    "build:cli": "tsx scripts/build-cli.ts",
    "cli": "tsx cli/index.ts",
    "preview": "vite preview",
    "sync": "tsx scripts/sync-github.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "worker:check": "wrangler deploy --dry-run --config worker/wrangler.jsonc",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run worker:check",
    "prepare": "npm run build:cli"
  },
  "dependencies": {
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260830.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260828.1": true
  }
}
